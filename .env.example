# Copy to .env and fill secrets. Never commit real secrets.
DB_USER=docpro
DB_PASSWORD=docpro_secret
DB_NAME=docpro

# ==========================
# Object Storage — dual driver (local MinIO vs production S3)
# STORAGE_DRIVER=minio (local, default) | STORAGE_DRIVER=s3 (VPS)
# ==========================
STORAGE_DRIVER=minio

# --- S3 (used when STORAGE_DRIVER=s3, i.e. on the VPS) ---
# All objects live in a single shared bucket, separated by a per-tenant prefix.
ACCESS_HOST=https://kencana.basic.box.cloudeka.id
ACCESS_REGION=kencana
ACCESS_BUCKET=docpro-aabiqe
ACCESS_ID=
ACCESS_SECRET=

# --- MinIO (used when STORAGE_DRIVER=minio, i.e. local dev) ---
# One real bucket per tenant; buckets are auto-created on first use.
MINIO_ENDPOINT=http://localhost:9000
MINIO_ROOT_USER=docpro
MINIO_ROOT_PASSWORD=docpro_secret
MINIO_BUCKET=docpro-person

# App
DATABASE_URL=postgres://docpro:docpro_secret@localhost:5432/docpro
SESSION_SECRET=change_me

# ==========================
# AI Provider
# ==========================

AI_URL=https://ai.sumopod.com
AI_KEY=
AI_MODEL=deepseek-v4-flash

# ==========================
# Embedding (Ollama lokal — nomic-embed-text, 768-dim)
# ==========================

EMBEDDING_URL=http://localhost:11434/api/embeddings
EMBEDDING_MODEL=nomic-embed-text

# ==========================
# Google OAuth (login SSO)
# ==========================

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ==========================
# Sentry (error tracking)
# ==========================

VITE_SENTRY_DSN=https://xxxxx@xxxxx.ingest.us.sentry.io/xxxxx
VITE_SENTRY_ENV=development
